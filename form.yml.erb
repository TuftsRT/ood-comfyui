<%
  @partition_filter = :all
  _partial_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/resource_discovery.erb'
  ERB.new(File.read(_partial_path)).result(binding)
%>
---
cluster: "pax"

form:
  - disclaimer_block
  - bc_num_hours
  - num_cores
  - num_memory
  - partition
  - gpu_type
  - version
  - modeldir
  - datadir
  - extra_parameters
  - ta_qos

attributes:
<%= generate_partition_field.indent(2) %>  
<%= generate_num_cores_field.indent(2) %>
<%= generate_num_memory_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>
<%= generate_num_hours_field.indent(2) %>

  disclaimer_block:
    widget: text_field
    class: "d-none"
    skip_label: true
<% if File.exist?("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md")  %>
    help: |
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md").indent(11) %>
<%end%>

  version:
    label: Version
    widget: select
    options:
         - ["0.27.0"]
         - ["0.19.0"]
         - ["0.12.2"]
         - ["0.9.2"]
  modeldir:
    label: Model directory
    widget: path_selector
    value: "/cluster/tufts/hpc/tools/comfyui/models"
    directory: /cluster/tufts
    favorites:
      - /cluster/tufts
      - /cluster/home

  datadir:
    label: "DATA_DIR"
    widget: path_selector
    directory: /cluster/tufts
    help: "Specifies the base directory for storing data such as uploads, cache, and vector database files. If left unset, it defaults to **${HOME}/comfyui/data**."
    favorites:
      - /cluster/tufts
      - /cluster/home

  extra_parameters:
    widget: text_field
    required: false
    label: Extra command line arguments
    value: "--use-sage-attention --disable-xformers --supports-fp8-compute --disable-smart-memory"
    help: |
            Extra command line arguments provided to main.py. 

  ta_qos:
    widget: check_box
    label: "Request priority start"
    help: "Starts sooner, but is limited to 1 running job, up to 64 CPUs, and up to 64 GB of memory. If you need more resources, leave this unchecked."
    value: "normal"
    checked_value: "interactive"
    unchecked_value: "normal"
