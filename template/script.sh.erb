#!/bin/bash
set -euo pipefail

# --- Configuration (OOD Context) ---
MODELDIR="<%= context.modeldir %>"
DATA_DIR="<%= context.datadir %>"
VER="<%= context.version %>"
COMFYUI_SIF="/cluster/tufts/ngc/images/comfyui_${VER}.sif"
OVERLAY_IMG="${DATA_DIR}/comfyui_overlay_${USER}_${VER}.img"
extra_parameters="<%= context.extra_parameters %>"
COMFYUI_PORT=$port

# --- Define Overlay Shadow Paths ---
WRITABLE_BASE="/writable_root"
WRITABLE_APP="${WRITABLE_BASE}/app"
WRITABLE_OPT="${WRITABLE_BASE}/opt"

# ================================
# Environment Setup
# ================================
module purge
module load singularity

# UNIFIED PATH: Prioritize Writable Overlay, then System CUDA
export SINGULARITYENV_PATH="${WRITABLE_OPT}/bin:/opt/nvidia/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# CUDA HOME & LIBRARIES: Directs installers to /opt/nvidia instead of standard paths
export SINGULARITYENV_CUDA_HOME="/opt/nvidia"
export SINGULARITYENV_LD_LIBRARY_PATH="/opt/nvidia/lib64:/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"

# REDIRECTION: Forces Python and uv to use the writable overlay
export SINGULARITYENV_UV_LINK_MODE="copy"

# ================================
# Step 1: Manage Overlay
# ================================
if [ ! -f "$OVERLAY_IMG" ]; then
    echo "▶️ Creating 50GB sparse overlay..."
    mkdir -p "$(dirname "$OVERLAY_IMG")"
    singularity overlay create --size 51200 --sparse "$OVERLAY_IMG"
fi

# ================================
# Step 2: Launch & Initialize
# ================================
DATA_OUTPUT=$DATA_DIR/output
mkdir -p "$DATA_OUTPUT"

# We use a HEREDOC style for the inner script to avoid quote nesting hell
singularity exec --nv \
    --overlay "${OVERLAY_IMG}" \
    -B "${DATA_OUTPUT}:/writable_root/app/output" \
    -B "${MODELDIR}:/writable_root/app/models" \
    "${COMFYUI_SIF}" \
    /bin/bash << 'EOF'
        # --- Shadow variables inside the container ---
        WRITABLE_APP="/writable_root/app"
        WRITABLE_OPT="/writable_root/opt"
        export PYTHONPATH="${WRITABLE_APP}:${WRITABLE_OPT}/lib/python3.11/site-packages"
        # One-time population of the overlay
        if [ ! -d "${WRITABLE_APP}/comfy/ldm/models" ]; then
            echo "▶️ Initializing Overlay (Attribute-Safe Mode)..."
            mkdir -p ${WRITABLE_APP} ${WRITABLE_OPT}
            
            # -rl: Recursive and copy symlinks
            # --no-t --no-p --no-g --no-o: Explicitly DO NOT sync times, perms, group, or owner
            # --ignore-errors: Continue even if that one 'ld' link is broken
            
            echo "▶️ Copying ComfyUI Code..."
            rsync -rl --no-t --no-p --no-g --no-o --ignore-errors \
            --exclude='/models' --exclude='/output' \
            /app/ ${WRITABLE_APP}/
            
            echo "▶️ Copying Conda Environment..."
            rsync -rl --no-t --no-p --no-g --no-o --ignore-errors /opt/conda/ ${WRITABLE_OPT}/
            
            mkdir -p ${WRITABLE_APP}/models ${WRITABLE_APP}/output
            echo "✅ Initialization complete."
        fi

        # FIX: Git Safe Directory
        git config --global --add safe.directory /app
        git config --global --add safe.directory ${WRITABLE_APP}

        cd ${WRITABLE_APP}

        # FIX: Pre-install nvdiffrast if missing
        if ! python3 -c "import nvdiffrast" &>/dev/null; then
            echo "▶️ Installing nvdiffrast..."
            python3 -m pip install git+https://github.com/NVlabs/nvdiffrast.git
        fi

        echo "▶️ Starting ComfyUI Server..."
        # We use env vars passed from the host for port and params
        python3 main.py --listen 0.0.0.0 --port ${SINGULARITYENV_PORT:-$port} ${extra_parameters:-}
EOF
